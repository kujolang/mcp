{
  "server": {
    "name": "mcp-production",
    "version": "1.0.0",
    "description": "MCP Server Production Profile"
  },
  "http": {
    "host": "0.0.0.0",
    "port": 8931,
    "max_request_body_bytes": 131072,
    "rate_limit_enabled": true,
    "rate_limit_per_minute": 120,
    "rate_limit_strategy": "local"
  },
  "permissions": {
    "allowed_directories": ["/srv/mcp/workspace"],
    "max_file_size": 1048576,
    "read_only_patterns": ["*.md", "*.txt", "*.json", "*.yaml", "*.yml"]
  },
  "logging": {
    "max_entries": 1000,
    "log_file": "/var/log/mcp/mcp-calls.log"
  },
  "tools": {
    "enabled": true,
    "default_timeout_ms": 15000,
    "scan_max_entries": 8000,
    "scan_max_files": 4000,
    "scan_max_bytes": 67108864,
    "tree_cache_enabled": true
  },
  "resources": {
    "enabled": true
  },
  "auth": {
    "enabled": true,
    "type": "bearer",
    "token": "REPLACE_WITH_LONG_RANDOM_SECRET"
  }
}
