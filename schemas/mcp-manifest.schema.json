{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.github.io/mcp/schemas/mcp-manifest.schema.json",
  "title": "MCP Generated Manifest",
  "description": "Schema for mcp.manifest.json produced by kujo mcp make.",
  "type": "object",
  "required": ["server", "tools", "resources", "prompts", "safe_command_map", "blocked_commands", "safety_tiers"],
  "properties": {
    "server": {
      "type": "object",
      "required": ["name", "version", "generated_at", "source_repo"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 1 },
        "source_repo": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "input_schema", "safety_tier"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "input_schema": { "type": "object" },
          "output_shape": { "type": "object" },
          "safety_tier": { "type": "string", "enum": ["read_only", "safe_command", "write_scaffold", "review_required", "blocked"] },
          "source_evidence": { "type": "array", "items": { "type": "string" } },
          "validation_status": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri", "name", "description", "mime_type", "path"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "mime_type": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "safe_command_map": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "blocked_commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety_tiers": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    }
  }
}
