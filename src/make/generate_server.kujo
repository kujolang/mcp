from src.make.common import dict_has_key, ensure_dir_recursive, write_output_file, push_unique, render_lines
from src.make.safety import classify_script

func has_safe_command(profile, command_text) {
    if command_text == "" {
        return false
    }

    if dict_has_key(profile, "safe_operations") == false {
        return false
    }

    safe_ops := profile["safe_operations"]
    if type(safe_ops) != "array" {
        return false
    }

    idx := 0
    while idx < len(safe_ops) {
        entry := safe_ops[idx]
        idx := idx + 1
        if type(entry) == "dict" {
            if dict_has_key(entry, "command") {
                if to_string(entry["command"]) == command_text {
                    return true
                }
            }
        }
    }

    inferred := classify_script("inferred", command_text)
    if inferred["tier"] == "safe_command" {
        return true
    }

    return false
}

func build_base_tools(profile) {
    tools := []

    tools := push(tools, {
        "name": "inspect_project_structure",
        "description": "Summarize repository structure, source roots, and test roots.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"repo_name": {"type": "string"}, "top_level_directories": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "list_available_scripts",
        "description": "List discovered scripts and inferred command safety tiers.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"scripts": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.available_scripts"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "inspect_package_metadata",
        "description": "Return package manager, build system, and likely install/build/test commands.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"package_manager": {"type": "string"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.package_manager"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "inspect_config_files",
        "description": "List important config files detected during deterministic repository analysis.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"important_config_files": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.important_config_files"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "summarize_entrypoints",
        "description": "Summarize likely repository entrypoint files.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"entrypoints": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.entrypoints"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "find_relevant_files_for_task",
        "description": "Search sampled repository file paths for task-relevant terms.",
        "input_schema": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "Search keyword"},
                "max_results": {"type": "integer", "minimum": 1, "maximum": 200}
            },
            "required": ["query"]
        },
        "output_shape": {"type": "object", "properties": {"matches": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.sample_files"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "generate_task_context",
        "description": "Generate concise repository context and suggestions for an implementation task.",
        "input_schema": {
            "type": "object",
            "properties": {
                "task": {"type": "string", "description": "Task description"}
            },
            "required": ["task"]
        },
        "output_shape": {"type": "object", "properties": {"context": {"type": "object"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "explain_domain_model",
        "description": "Explain domain concepts inferred from repo docs and file names.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"domain_concepts": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.mcp_relevant_domain_concepts"],
        "validation_status": "generated"
    })

    tools := push(tools, {
        "name": "inspect_recent_changes",
        "description": "Return conservative recent-change hints based on analysis limitations and assumptions.",
        "input_schema": {"type": "object", "properties": {}, "required": []},
        "output_shape": {"type": "object", "properties": {"confidence_notes": {"type": "array"}}},
        "safety_tier": "read_only",
        "source_evidence": ["repo-profile.json.confidence_notes"],
        "validation_status": "generated"
    })

    return tools
}

func build_safe_command_tools(profile, safe_command_map) {
    safe_tool_defs := []

    likely_test := ""
    likely_lint := ""
    likely_build := ""
    if dict_has_key(profile, "likely_test_command") {
        likely_test := to_string(profile["likely_test_command"])
    }
    if dict_has_key(profile, "likely_lint_command") {
        likely_lint := to_string(profile["likely_lint_command"])
    }
    if dict_has_key(profile, "likely_build_command") {
        likely_build := to_string(profile["likely_build_command"])
    }

    if has_safe_command(profile, likely_test) {
        safe_command_map["run_safe_test_suite"] := likely_test
        safe_tool_defs := push(safe_tool_defs, {
            "name": "run_safe_test_suite",
            "description": "Run allowlisted safe test command inferred from repository metadata.",
            "input_schema": {"type": "object", "properties": {}, "required": []},
            "output_shape": {"type": "object", "properties": {"command": {"type": "string"}, "result": {"type": "object"}}},
            "safety_tier": "safe_command",
            "source_evidence": ["repo-profile.json.likely_test_command"],
            "validation_status": "generated"
        })
    }

    if has_safe_command(profile, likely_lint) {
        safe_command_map["run_lint"] := likely_lint
        safe_tool_defs := push(safe_tool_defs, {
            "name": "run_lint",
            "description": "Run allowlisted lint/static-analysis command inferred from repository metadata.",
            "input_schema": {"type": "object", "properties": {}, "required": []},
            "output_shape": {"type": "object", "properties": {"command": {"type": "string"}, "result": {"type": "object"}}},
            "safety_tier": "safe_command",
            "source_evidence": ["repo-profile.json.likely_lint_command"],
            "validation_status": "generated"
        })
    }

    if has_safe_command(profile, likely_build) {
        safe_command_map["validate_build"] := likely_build
        safe_tool_defs := push(safe_tool_defs, {
            "name": "validate_build",
            "description": "Run allowlisted build validation command inferred from repository metadata.",
            "input_schema": {"type": "object", "properties": {}, "required": []},
            "output_shape": {"type": "object", "properties": {"command": {"type": "string"}, "result": {"type": "object"}}},
            "safety_tier": "safe_command",
            "source_evidence": ["repo-profile.json.likely_build_command"],
            "validation_status": "generated"
        })
    }

    return safe_tool_defs
}

func build_resources(profile, out_abs, artifacts_abs) {
    resources := []

    resources := push(resources, {
        "uri": "repo://profile",
        "name": "Repository Profile",
        "description": "Deterministic profile produced by kujo mcp make.",
        "mime_type": "application/json",
        "path": out_abs + "/repo-profile.json"
    })

    resources := push(resources, {
        "uri": "repo://manifest",
        "name": "Generated MCP Manifest",
        "description": "Generated tool/resource/prompt manifest.",
        "mime_type": "application/json",
        "path": out_abs + "/mcp.manifest.json"
    })

    resources := push(resources, {
        "uri": "repo://map",
        "name": "Repository Map",
        "description": "Human-readable repository structure map.",
        "mime_type": "text/markdown",
        "path": artifacts_abs + "/repo-map.md"
    })

    resources := push(resources, {
        "uri": "repo://validation",
        "name": "Validation Report",
        "description": "Validation outcomes for generated assets and server.",
        "mime_type": "text/markdown",
        "path": artifacts_abs + "/validation-report.md"
    })

    resources := push(resources, {
        "uri": "repo://fix-backlog",
        "name": "Fix Backlog",
        "description": "Prioritized backlog of concrete repository improvements.",
        "mime_type": "text/markdown",
        "path": artifacts_abs + "/fix-backlog.md"
    })

    docs := []
    if dict_has_key(profile, "docs_and_readmes") {
        docs := profile["docs_and_readmes"]
    }

    if type(docs) == "array" && len(docs) > 0 {
        root_abs := to_string(profile["repo_path_absolute"])
        primary_doc_rel := to_string(docs[0])
        resources := push(resources, {
            "uri": "repo://primary-doc",
            "name": "Primary Documentation",
            "description": "Primary README/docs file detected for this repository.",
            "mime_type": "text/markdown",
            "path": root_abs + "/" + primary_doc_rel
        })
    }

    return resources
}

func build_prompts(out_abs) {
    prompts := []

    prompts := push(prompts, {
        "name": "prepare_implementation_plan",
        "description": "Prepare an implementation plan grounded in repository evidence.",
        "path": out_abs + "/src/prompts/prepare_implementation_plan.md"
    })

    prompts := push(prompts, {
        "name": "review_patch",
        "description": "Review a patch for safety, regressions, and test completeness.",
        "path": out_abs + "/src/prompts/review_patch.md"
    })

    prompts := push(prompts, {
        "name": "write_tests",
        "description": "Design tests that validate behavior and guard against regressions.",
        "path": out_abs + "/src/prompts/write_tests.md"
    })

    prompts := push(prompts, {
        "name": "investigate_failing_test",
        "description": "Investigate failing tests with deterministic reproduction and root-cause notes.",
        "path": out_abs + "/src/prompts/investigate_failing_test.md"
    })

    prompts := push(prompts, {
        "name": "produce_agent_handoff",
        "description": "Produce a handoff packet for another local coding agent.",
        "path": out_abs + "/src/prompts/produce_agent_handoff.md"
    })

    return prompts
}

func kujo_string_literal(value) {
    escaped := replace(to_string(value), "\\", "\\\\")
    escaped := replace(escaped, "\"", "\\\"")
    escaped := replace(escaped, "\r", "\\r")
    escaped := replace(escaped, "\n", "\\n")
    escaped := replace(escaped, "\t", "\\t")
    return "\"" + escaped + "\""
}

func render_generated_server_source(manifest_abs, profile_abs, config_abs, out_abs, artifacts_abs) {
    lines := []
    lines := push(lines, "MANIFEST_PATH := " + kujo_string_literal(manifest_abs))
    lines := push(lines, "PROFILE_PATH := " + kujo_string_literal(profile_abs))
    lines := push(lines, "CONFIG_PATH := " + kujo_string_literal(config_abs))
    lines := push(lines, "GENERATED_SERVER_ROOT := " + kujo_string_literal(out_abs))
    lines := push(lines, "GENERATED_ARTIFACTS_ROOT := " + kujo_string_literal(artifacts_abs))
    lines := push(lines, "")
    lines := push(lines, "func dict_has_key(dict_value, key_name) {")
    lines := push(lines, "    probe := has_key(dict_value, key_name)")
    lines := push(lines, "    if type(probe) == \"bool\" {")
    lines := push(lines, "        return probe")
    lines := push(lines, "    }")
    lines := push(lines, "    if type(probe) == \"int\" {")
    lines := push(lines, "        return probe == 1")
    lines := push(lines, "    }")
    lines := push(lines, "    return false")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func config_fail(message) {")
    lines := push(lines, "    assert(false, \"Invalid generated mcp-server.json: \" + message)")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func require_dict(parent, key_name, scope_name) {")
    lines := push(lines, "    if !dict_has_key(parent, key_name) || type(parent[key_name]) != \"dict\" {")
    lines := push(lines, "        config_fail(scope_name + \".\" + key_name + \" must be an object\")")
    lines := push(lines, "    }")
    lines := push(lines, "    return parent[key_name]")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func require_string(parent, key_name, scope_name) {")
    lines := push(lines, "    if !dict_has_key(parent, key_name) || type(parent[key_name]) != \"string\" || trim(parent[key_name]) == \"\" {")
    lines := push(lines, "        config_fail(scope_name + \".\" + key_name + \" must be a non-empty string\")")
    lines := push(lines, "    }")
    lines := push(lines, "    return trim(parent[key_name])")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func require_positive_int(parent, key_name, scope_name) {")
    lines := push(lines, "    if !dict_has_key(parent, key_name) || type(parent[key_name]) != \"int\" || parent[key_name] <= 0 {")
    lines := push(lines, "        config_fail(scope_name + \".\" + key_name + \" must be a positive integer\")")
    lines := push(lines, "    }")
    lines := push(lines, "    return parent[key_name]")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func require_bool(parent, key_name, scope_name) {")
    lines := push(lines, "    if !dict_has_key(parent, key_name) || type(parent[key_name]) != \"bool\" {")
    lines := push(lines, "        config_fail(scope_name + \".\" + key_name + \" must be a boolean\")")
    lines := push(lines, "    }")
    lines := push(lines, "    return parent[key_name] == true")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func optional_string(parent, key_name, scope_name, default_value) {")
    lines := push(lines, "    if !dict_has_key(parent, key_name) { return default_value }")
    lines := push(lines, "    if type(parent[key_name]) != \"string\" { config_fail(scope_name + \".\" + key_name + \" must be a string\") }")
    lines := push(lines, "    return trim(parent[key_name])")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func load_json_file(path_text) {")
    lines := push(lines, "    raw := read_file(path_text)")
    lines := push(lines, "    parsed := parse_json(raw)")
    lines := push(lines, "    if type(parsed) != \"dict\" {")
    lines := push(lines, "        assert(false, \"Generated JSON file must be an object: \" + path_text)")
    lines := push(lines, "    }")
    lines := push(lines, "    return parsed")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "manifest := load_json_file(MANIFEST_PATH)")
    lines := push(lines, "profile := load_json_file(PROFILE_PATH)")
    lines := push(lines, "config := load_json_file(CONFIG_PATH)")
    lines := push(lines, "server_cfg := require_dict(config, \"server\", \"root\")")
    lines := push(lines, "http_cfg := require_dict(config, \"http\", \"root\")")
    lines := push(lines, "auth_cfg := require_dict(config, \"auth\", \"root\")")
    lines := push(lines, "permissions_cfg := require_dict(config, \"permissions\", \"root\")")
    lines := push(lines, "tools_cfg := require_dict(config, \"tools\", \"root\")")
    lines := push(lines, "resources_cfg := require_dict(config, \"resources\", \"root\")")
    lines := push(lines, "SERVER_NAME := require_string(server_cfg, \"name\", \"server\")")
    lines := push(lines, "SERVER_VERSION := require_string(server_cfg, \"version\", \"server\")")
    lines := push(lines, "HOST := require_string(http_cfg, \"host\", \"http\")")
    lines := push(lines, "PORT := require_positive_int(http_cfg, \"port\", \"http\")")
    lines := push(lines, "if PORT > 65535 { config_fail(\"http.port must be between 1 and 65535\") }")
    lines := push(lines, "MAX_REQUEST_BODY_BYTES := require_positive_int(http_cfg, \"max_request_body_bytes\", \"http\")")
    lines := push(lines, "RATE_LIMIT_ENABLED := require_bool(http_cfg, \"rate_limit_enabled\", \"http\")")
    lines := push(lines, "RATE_LIMIT_PER_MINUTE := require_positive_int(http_cfg, \"rate_limit_per_minute\", \"http\")")
    lines := push(lines, "RATE_LIMIT_STRATEGY := to_lower(optional_string(http_cfg, \"rate_limit_strategy\", \"http\", \"local\"))")
    lines := push(lines, "if RATE_LIMIT_STRATEGY != \"local\" && RATE_LIMIT_STRATEGY != \"external\" { config_fail(\"http.rate_limit_strategy must be local or external\") }")
    lines := push(lines, "RATE_LIMIT_GATEWAY_HEADER := optional_string(http_cfg, \"rate_limit_gateway_header\", \"http\", \"X-Kujo-Rate-Limit-Token\")")
    lines := push(lines, "RATE_LIMIT_GATEWAY_TOKEN := optional_string(http_cfg, \"rate_limit_gateway_token\", \"http\", \"\")")
    lines := push(lines, "if RATE_LIMIT_ENABLED && RATE_LIMIT_STRATEGY == \"external\" && RATE_LIMIT_GATEWAY_TOKEN == \"\" { config_fail(\"http.rate_limit_gateway_token must be non-empty when external rate limiting is enabled\") }")
    lines := push(lines, "AUTH_ENABLED := require_bool(auth_cfg, \"enabled\", \"auth\")")
    lines := push(lines, "AUTH_TYPE := require_string(auth_cfg, \"type\", \"auth\")")
    lines := push(lines, "if AUTH_TYPE != \"bearer\" && AUTH_TYPE != \"api_key\" { config_fail(\"auth.type must be bearer or api_key\") }")
    lines := push(lines, "AUTH_TOKEN := \"\"")
    lines := push(lines, "if dict_has_key(auth_cfg, \"token\") && type(auth_cfg[\"token\"]) == \"string\" { AUTH_TOKEN := auth_cfg[\"token\"] }")
    lines := push(lines, "if AUTH_ENABLED && trim(AUTH_TOKEN) == \"\" { config_fail(\"auth.token must be non-empty when auth is enabled\") }")
    lines := push(lines, "TOOLS_ENABLED := require_bool(tools_cfg, \"enabled\", \"tools\")")
    lines := push(lines, "TOOLS_DEFAULT_TIMEOUT_MS := require_positive_int(tools_cfg, \"default_timeout_ms\", \"tools\")")
    lines := push(lines, "RESOURCES_ENABLED := require_bool(resources_cfg, \"enabled\", \"resources\")")
    lines := push(lines, "MAX_FILE_SIZE := require_positive_int(permissions_cfg, \"max_file_size\", \"permissions\")")
    lines := push(lines, "RESOURCE_ROOTS := [to_string(profile[\"repo_path_absolute\"]), GENERATED_SERVER_ROOT, GENERATED_ARTIFACTS_ROOT]")
    lines := push(lines, "")
    lines := push(lines, "tools := []")
    lines := push(lines, "resources := []")
    lines := push(lines, "prompts := []")
    lines := push(lines, "safe_command_map := {}")
    lines := push(lines, "")
    lines := push(lines, "if dict_has_key(manifest, \"tools\") && type(manifest[\"tools\"]) == \"array\" {")
    lines := push(lines, "    tools := manifest[\"tools\"]")
    lines := push(lines, "}")
    lines := push(lines, "if dict_has_key(manifest, \"resources\") && type(manifest[\"resources\"]) == \"array\" {")
    lines := push(lines, "    resources := manifest[\"resources\"]")
    lines := push(lines, "}")
    lines := push(lines, "if dict_has_key(manifest, \"prompts\") && type(manifest[\"prompts\"]) == \"array\" {")
    lines := push(lines, "    prompts := manifest[\"prompts\"]")
    lines := push(lines, "}")
    lines := push(lines, "if dict_has_key(manifest, \"safe_command_map\") && type(manifest[\"safe_command_map\"]) == \"dict\" {")
    lines := push(lines, "    safe_command_map := manifest[\"safe_command_map\"]")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func is_path_inside_root(candidate_abs, root_abs) {")
    lines := push(lines, "    if candidate_abs == root_abs {")
    lines := push(lines, "        return true")
    lines := push(lines, "    }")
    lines := push(lines, "    return starts_with(candidate_abs, root_abs + \"/\")")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func is_resource_path_allowed(file_path) {")
    lines := push(lines, "    candidate_abs := path_absolute(file_path)")
    lines := push(lines, "    idx := 0")
    lines := push(lines, "    while idx < len(RESOURCE_ROOTS) {")
    lines := push(lines, "        root_abs := path_absolute(to_string(RESOURCE_ROOTS[idx]))")
    lines := push(lines, "        idx := idx + 1")
    lines := push(lines, "        if is_path_inside_root(candidate_abs, root_abs) {")
    lines := push(lines, "            return true")
    lines := push(lines, "        }")
    lines := push(lines, "    }")
    lines := push(lines, "    return false")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func get_header(req, header_name) {")
    lines := push(lines, "    headers := {}")
    lines := push(lines, "    try { headers := req[\"headers\"] } except err { headers := {} }")
    lines := push(lines, "    if type(headers) != \"dict\" { return \"\" }")
    lines := push(lines, "    wanted := to_lower(header_name)")
    lines := push(lines, "    for key in keys(headers) {")
    lines := push(lines, "        if to_lower(to_string(key)) == wanted { return to_string(headers[key]) }")
    lines := push(lines, "    }")
    lines := push(lines, "    return \"\"")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func host_allowed(req) {")
    lines := push(lines, "    expected := to_lower(trim(HOST))")
    lines := push(lines, "    if expected == \"0.0.0.0\" || expected == \"::\" { return true }")
    lines := push(lines, "    provided := to_lower(trim(get_header(req, \"Host\")))")
    lines := push(lines, "    if provided == \"\" { return false }")
    lines := push(lines, "    parts := split(provided, \":\")")
    lines := push(lines, "    actual := trim(parts[0])")
    lines := push(lines, "    if expected == \"localhost\" { return actual == \"localhost\" || actual == \"127.0.0.1\" }")
    lines := push(lines, "    return actual == expected")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func request_authorized(req) {")
    lines := push(lines, "    if !AUTH_ENABLED { return true }")
    lines := push(lines, "    if AUTH_TYPE == \"api_key\" { return trim(get_header(req, \"X-API-Key\")) == trim(AUTH_TOKEN) }")
    lines := push(lines, "    header := trim(get_header(req, \"Authorization\"))")
    lines := push(lines, "    if !starts_with(header, \"Bearer \") { return false }")
    lines := push(lines, "    return trim(substring(header, 7, len(header))) == trim(AUTH_TOKEN)")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "REQUEST_LIMIT_STATE := {\"window\": \"\", \"count\": 0}")
    lines := push(lines, "")
    lines := push(lines, "func enforce_request_guards(req) {")
    lines := push(lines, "    if !host_allowed(req) { return {\"ok\": false, \"status\": 403, \"body\": {\"error\": \"Host header is not allowed\"}} }")
    lines := push(lines, "    if !request_authorized(req) { return {\"ok\": false, \"status\": 401, \"body\": {\"error\": \"Unauthorized request\"}} }")
    lines := push(lines, "    body_size := 0")
    lines := push(lines, "    try {")
    lines := push(lines, "        body_size := len(to_string(req[\"body\"]))")
    lines := push(lines, "    } except err {")
    lines := push(lines, "    }")
    lines := push(lines, "    if body_size > MAX_REQUEST_BODY_BYTES {")
    lines := push(lines, "        return {\"ok\": false, \"status\": 413, \"body\": {\"error\": \"Request body exceeds configured maximum\"}}")
    lines := push(lines, "    }")
    lines := push(lines, "    if RATE_LIMIT_ENABLED {")
    lines := push(lines, "        if RATE_LIMIT_STRATEGY == \"external\" {")
    lines := push(lines, "            if trim(get_header(req, RATE_LIMIT_GATEWAY_HEADER)) != RATE_LIMIT_GATEWAY_TOKEN { return {\"ok\": false, \"status\": 429, \"body\": {\"error\": \"External rate-limit attestation required\"}} }")
    lines := push(lines, "            return {\"ok\": true, \"status\": 200, \"body\": {}}")
    lines := push(lines, "        }")
    lines := push(lines, "        window := format_date(now(), \"YYYY-MM-DD HH:mm\")")
    lines := push(lines, "        if REQUEST_LIMIT_STATE[\"window\"] != window { REQUEST_LIMIT_STATE[\"window\"] := window; REQUEST_LIMIT_STATE[\"count\"] := 0 }")
    lines := push(lines, "        if REQUEST_LIMIT_STATE[\"count\"] >= RATE_LIMIT_PER_MINUTE { return {\"ok\": false, \"status\": 429, \"body\": {\"error\": \"Rate limit exceeded\"}} }")
    lines := push(lines, "        REQUEST_LIMIT_STATE[\"count\"] := REQUEST_LIMIT_STATE[\"count\"] + 1")
    lines := push(lines, "    }")
    lines := push(lines, "    return {\"ok\": true, \"status\": 200, \"body\": {}}")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func find_tool(tool_name) {")
    lines := push(lines, "    idx := 0")
    lines := push(lines, "    while idx < len(tools) {")
    lines := push(lines, "        candidate := tools[idx]")
    lines := push(lines, "        idx := idx + 1")
    lines := push(lines, "        if type(candidate) == \"dict\" {")
    lines := push(lines, "            if dict_has_key(candidate, \"name\") {")
    lines := push(lines, "                if to_string(candidate[\"name\"]) == tool_name {")
    lines := push(lines, "                    return candidate")
    lines := push(lines, "                }")
    lines := push(lines, "            }")
    lines := push(lines, "        }")
    lines := push(lines, "    }")
    lines := push(lines, "    return null")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func execute_tool(tool_name, tool_args) {")
    lines := push(lines, "    if tool_name == \"inspect_project_structure\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {")
    lines := push(lines, "            \"repo_name\": profile[\"repo_name\"],")
    lines := push(lines, "            \"top_level_directories\": profile[\"top_level_directories\"],")
    lines := push(lines, "            \"source_directories\": profile[\"likely_source_directories\"],")
    lines := push(lines, "            \"test_directories\": profile[\"likely_test_directories\"]")
    lines := push(lines, "        }}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"list_available_scripts\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"scripts\": profile[\"available_scripts\"]}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"inspect_package_metadata\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {")
    lines := push(lines, "            \"package_manager\": profile[\"package_manager\"],")
    lines := push(lines, "            \"build_system\": profile[\"build_system\"],")
    lines := push(lines, "            \"likely_install_command\": profile[\"likely_install_command\"],")
    lines := push(lines, "            \"likely_test_command\": profile[\"likely_test_command\"],")
    lines := push(lines, "            \"likely_lint_command\": profile[\"likely_lint_command\"],")
    lines := push(lines, "            \"likely_build_command\": profile[\"likely_build_command\"]")
    lines := push(lines, "        }}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"inspect_config_files\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"important_config_files\": profile[\"important_config_files\"]}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"summarize_entrypoints\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"entrypoints\": profile[\"entrypoints\"]}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"explain_domain_model\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"domain_concepts\": profile[\"mcp_relevant_domain_concepts\"]}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"inspect_recent_changes\" {")
    lines := push(lines, "        return {\"ok\": true, \"data\": {")
    lines := push(lines, "            \"confidence_notes\": profile[\"confidence_notes\"],")
    lines := push(lines, "            \"unresolved_assumptions\": profile[\"unresolved_assumptions\"]")
    lines := push(lines, "        }}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"find_relevant_files_for_task\" {")
    lines := push(lines, "        query := \"\"")
    lines := push(lines, "        if dict_has_key(tool_args, \"query\") {")
    lines := push(lines, "            query := to_lower(trim(to_string(tool_args[\"query\"])))")
    lines := push(lines, "        }")
    lines := push(lines, "        if query == \"\" {")
    lines := push(lines, "            return {\"ok\": false, \"error\": \"query is required\"}")
    lines := push(lines, "        }")
    lines := push(lines, "")
    lines := push(lines, "        max_results := 25")
    lines := push(lines, "        if dict_has_key(tool_args, \"max_results\") && type(tool_args[\"max_results\"]) == \"int\" {")
    lines := push(lines, "            if tool_args[\"max_results\"] > 0 {")
    lines := push(lines, "                max_results := tool_args[\"max_results\"]")
    lines := push(lines, "            }")
    lines := push(lines, "        }")
    lines := push(lines, "")
    lines := push(lines, "        files := profile[\"sample_files\"]")
    lines := push(lines, "        matches := []")
    lines := push(lines, "        idx := 0")
    lines := push(lines, "        while idx < len(files) {")
    lines := push(lines, "            file_path := to_string(files[idx])")
    lines := push(lines, "            idx := idx + 1")
    lines := push(lines, "            if index_of(to_lower(file_path), query) >= 0 {")
    lines := push(lines, "                matches := push(matches, file_path)")
    lines := push(lines, "                if len(matches) >= max_results {")
    lines := push(lines, "                    break")
    lines := push(lines, "                }")
    lines := push(lines, "            }")
    lines := push(lines, "        }")
    lines := push(lines, "")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"query\": query, \"matches\": matches, \"total_matches\": len(matches)}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if tool_name == \"generate_task_context\" {")
    lines := push(lines, "        task_text := \"\"")
    lines := push(lines, "        if dict_has_key(tool_args, \"task\") {")
    lines := push(lines, "            task_text := trim(to_string(tool_args[\"task\"]))")
    lines := push(lines, "        }")
    lines := push(lines, "        if task_text == \"\" {")
    lines := push(lines, "            return {\"ok\": false, \"error\": \"task is required\"}")
    lines := push(lines, "        }")
    lines := push(lines, "")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"context\": {")
    lines := push(lines, "            \"task\": task_text,")
    lines := push(lines, "            \"entrypoints\": profile[\"entrypoints\"],")
    lines := push(lines, "            \"likely_test_command\": profile[\"likely_test_command\"],")
    lines := push(lines, "            \"likely_lint_command\": profile[\"likely_lint_command\"],")
    lines := push(lines, "            \"relevant_concepts\": profile[\"mcp_relevant_domain_concepts\"],")
    lines := push(lines, "            \"missing_tests\": profile[\"missing_tests\"]")
    lines := push(lines, "        }}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if dict_has_key(safe_command_map, tool_name) {")
    lines := push(lines, "        command_text := to_string(safe_command_map[tool_name])")
    lines := push(lines, "        result := execute_status(command_text, {\"timeout_ms\": TOOLS_DEFAULT_TIMEOUT_MS})")
    lines := push(lines, "        return {\"ok\": true, \"data\": {\"command\": command_text, \"result\": result}}")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    return {\"ok\": false, \"error\": \"Tool not implemented: \" + tool_name}")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func read_resource(uri) {")
    lines := push(lines, "    idx := 0")
    lines := push(lines, "    while idx < len(resources) {")
    lines := push(lines, "        entry := resources[idx]")
    lines := push(lines, "        idx := idx + 1")
    lines := push(lines, "        if type(entry) == \"dict\" && dict_has_key(entry, \"uri\") {")
    lines := push(lines, "            if to_string(entry[\"uri\"]) == uri {")
    lines := push(lines, "                file_path := to_string(entry[\"path\"])")
    lines := push(lines, "                if !file_exists(file_path) {")
    lines := push(lines, "                    return {\"ok\": false, \"error\": \"Resource file does not exist: \" + file_path}")
    lines := push(lines, "                }")
    lines := push(lines, "                if !is_resource_path_allowed(file_path) {")
    lines := push(lines, "                    return {\"ok\": false, \"error\": \"Resource path is outside generated server resource roots\"}")
    lines := push(lines, "                }")
    lines := push(lines, "                if file_size(file_path) > MAX_FILE_SIZE {")
    lines := push(lines, "                    return {\"ok\": false, \"error\": \"Resource exceeds max read size\"}")
    lines := push(lines, "                }")
    lines := push(lines, "                return {\"ok\": true, \"data\": {")
    lines := push(lines, "                    \"mime_type\": to_string(entry[\"mime_type\"]),")
    lines := push(lines, "                    \"text\": read_file(file_path)")
    lines := push(lines, "                }}")
    lines := push(lines, "            }")
    lines := push(lines, "        }")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    return {\"ok\": false, \"error\": \"Resource not found: \" + uri}")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func read_prompt(prompt_name) {")
    lines := push(lines, "    for entry in prompts {")
    lines := push(lines, "        if type(entry) == \"dict\" && dict_has_key(entry, \"name\") && to_string(entry[\"name\"]) == prompt_name {")
    lines := push(lines, "            file_path := to_string(entry[\"path\"])")
    lines := push(lines, "            if !file_exists(file_path) { return {\"ok\": false, \"error\": \"Prompt file does not exist\"} }")
    lines := push(lines, "            if !is_resource_path_allowed(file_path) { return {\"ok\": false, \"error\": \"Prompt path is outside generated server resource roots\"} }")
    lines := push(lines, "            if file_size(file_path) > MAX_FILE_SIZE { return {\"ok\": false, \"error\": \"Prompt exceeds max read size\"} }")
    lines := push(lines, "            return {\"ok\": true, \"data\": {\"description\": to_string(entry[\"description\"]), \"messages\": [{\"role\": \"user\", \"content\": {\"type\": \"text\", \"text\": read_file(file_path)}}]}}")
    lines := push(lines, "        }")
    lines := push(lines, "    }")
    lines := push(lines, "    return {\"ok\": false, \"error\": \"Prompt not found: \" + prompt_name}")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func standard_tool_list() {")
    lines := push(lines, "    result := []")
    lines := push(lines, "    for entry in tools {")
    lines := push(lines, "        result := push(result, {\"name\": entry[\"name\"], \"description\": entry[\"description\"], \"inputSchema\": entry[\"input_schema\"]})")
    lines := push(lines, "    }")
    lines := push(lines, "    return result")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func standard_resource_list() {")
    lines := push(lines, "    result := []")
    lines := push(lines, "    for entry in resources {")
    lines := push(lines, "        result := push(result, {\"uri\": entry[\"uri\"], \"name\": entry[\"name\"], \"description\": entry[\"description\"], \"mimeType\": entry[\"mime_type\"]})")
    lines := push(lines, "    }")
    lines := push(lines, "    return result")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "func standard_prompt_list() {")
    lines := push(lines, "    result := []")
    lines := push(lines, "    for entry in prompts { result := push(result, {\"name\": entry[\"name\"], \"description\": entry[\"description\"], \"arguments\": []}) }")
    lines := push(lines, "    return result")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "if len(args()) > 0 {")
    lines := push(lines, "    if args()[0] == \"--self-check\" {")
    lines := push(lines, "        print(to_json({")
    lines := push(lines, "            \"ok\": true,")
    lines := push(lines, "            \"tools\": len(tools),")
    lines := push(lines, "            \"resources\": len(resources),")
    lines := push(lines, "            \"server\": SERVER_NAME")
    lines := push(lines, "        }))")
    lines := push(lines, "        exit(0)")
    lines := push(lines, "    }")
    lines := push(lines, "}")
    lines := push(lines, "")
    lines := push(lines, "server := http_listen(HOST, PORT)")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"GET\", \"/mcp/v1/health\", func(req) {")
    lines := push(lines, "    guards := enforce_request_guards(req)")
    lines := push(lines, "    if !guards[\"ok\"] { return json_response(guards[\"status\"], guards[\"body\"]) }")
    lines := push(lines, "    return json_response(200, {\"status\": \"ok\", \"server\": SERVER_NAME, \"version\": SERVER_VERSION})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1/tools/list\", func(req) {")
    lines := push(lines, "    limits := enforce_request_guards(req)")
    lines := push(lines, "    if limits[\"ok\"] == false {")
    lines := push(lines, "        return json_response(limits[\"status\"], limits[\"body\"])")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if !TOOLS_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32010, \"message\": \"Tools are disabled by configuration\"}}) }")
    lines := push(lines, "")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"result\": {\"tools\": tools}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1/tools/call\", func(req) {")
    lines := push(lines, "    limits := enforce_request_guards(req)")
    lines := push(lines, "    if limits[\"ok\"] == false {")
    lines := push(lines, "        return json_response(limits[\"status\"], limits[\"body\"])")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if !TOOLS_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32010, \"message\": \"Tools are disabled by configuration\"}}) }")
    lines := push(lines, "")
    lines := push(lines, "    payload := {}")
    lines := push(lines, "    try {")
    lines := push(lines, "        payload := parse_json(req[\"body\"])")
    lines := push(lines, "    } except err {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32600, \"message\": \"Invalid JSON request body\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if !dict_has_key(payload, \"params\") || type(payload[\"params\"]) != \"dict\" {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"Missing params object\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    params := payload[\"params\"]")
    lines := push(lines, "    if !dict_has_key(params, \"name\") {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"Missing params.name\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    tool_name := trim(to_string(params[\"name\"]))")
    lines := push(lines, "    if tool_name == \"\" {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"params.name must be a non-empty string\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    tool_def := find_tool(tool_name)")
    lines := push(lines, "    if tool_def == null {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -1, \"message\": \"Tool not found: \" + tool_name}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    tool_args := {}")
    lines := push(lines, "    if dict_has_key(params, \"arguments\") && type(params[\"arguments\"]) == \"dict\" {")
    lines := push(lines, "        tool_args := params[\"arguments\"]")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    result := execute_tool(tool_name, tool_args)")
    lines := push(lines, "    if result[\"ok\"] {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"result\": result[\"data\"]})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -1, \"message\": result[\"error\"]}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1/resources/list\", func(req) {")
    lines := push(lines, "    limits := enforce_request_guards(req)")
    lines := push(lines, "    if limits[\"ok\"] == false {")
    lines := push(lines, "        return json_response(limits[\"status\"], limits[\"body\"])")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if !RESOURCES_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32011, \"message\": \"Resources are disabled by configuration\"}}) }")
    lines := push(lines, "")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"result\": {\"resources\": resources}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1/resources/read\", func(req) {")
    lines := push(lines, "    limits := enforce_request_guards(req)")
    lines := push(lines, "    if limits[\"ok\"] == false {")
    lines := push(lines, "        return json_response(limits[\"status\"], limits[\"body\"])")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if !RESOURCES_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32011, \"message\": \"Resources are disabled by configuration\"}}) }")
    lines := push(lines, "")
    lines := push(lines, "    payload := {}")
    lines := push(lines, "    try {")
    lines := push(lines, "        payload := parse_json(req[\"body\"])")
    lines := push(lines, "    } except err {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32600, \"message\": \"Invalid JSON request body\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    if !dict_has_key(payload, \"params\") || type(payload[\"params\"]) != \"dict\" {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"Missing params object\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    params := payload[\"params\"]")
    lines := push(lines, "    if !dict_has_key(params, \"uri\") {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"Missing params.uri\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    uri := trim(to_string(params[\"uri\"]))")
    lines := push(lines, "    if uri == \"\" {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"params.uri must be a non-empty string\"}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    result := read_resource(uri)")
    lines := push(lines, "    if result[\"ok\"] {")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"result\": {\"contents\": [{\"uri\": uri, \"mimeType\": result[\"data\"][\"mime_type\"], \"text\": result[\"data\"][\"text\"]}]}})")
    lines := push(lines, "    }")
    lines := push(lines, "")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -2, \"message\": result[\"error\"]}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1/prompts/list\", func(req) {")
    lines := push(lines, "    guards := enforce_request_guards(req)")
    lines := push(lines, "    if !guards[\"ok\"] { return json_response(guards[\"status\"], guards[\"body\"]) }")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"result\": {\"prompts\": standard_prompt_list()}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1/prompts/get\", func(req) {")
    lines := push(lines, "    guards := enforce_request_guards(req)")
    lines := push(lines, "    if !guards[\"ok\"] { return json_response(guards[\"status\"], guards[\"body\"]) }")
    lines := push(lines, "    payload := {}")
    lines := push(lines, "    try { payload := parse_json(req[\"body\"]) } except err { return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32600, \"message\": \"Invalid JSON request body\"}}) }")
    lines := push(lines, "    if !dict_has_key(payload, \"params\") || type(payload[\"params\"]) != \"dict\" || !dict_has_key(payload[\"params\"], \"name\") { return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": \"Missing params.name\"}}) }")
    lines := push(lines, "    result := read_prompt(trim(to_string(payload[\"params\"][\"name\"])))")
    lines := push(lines, "    if result[\"ok\"] { return json_response(200, {\"jsonrpc\": \"2.0\", \"result\": result[\"data\"]}) }")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32602, \"message\": result[\"error\"]}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "server := server.route(\"POST\", \"/mcp/v1\", func(req) {")
    lines := push(lines, "    guards := enforce_request_guards(req)")
    lines := push(lines, "    if !guards[\"ok\"] { return json_response(guards[\"status\"], guards[\"body\"]) }")
    lines := push(lines, "    payload := {}")
    lines := push(lines, "    try { payload := parse_json(req[\"body\"]) } except err { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": null, \"error\": {\"code\": -32700, \"message\": \"Parse error\"}}) }")
    lines := push(lines, "    if !dict_has_key(payload, \"jsonrpc\") || payload[\"jsonrpc\"] != \"2.0\" || !dict_has_key(payload, \"method\") || type(payload[\"method\"]) != \"string\" { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": null, \"error\": {\"code\": -32600, \"message\": \"Invalid Request\"}}) }")
    lines := push(lines, "    request_id := null")
    lines := push(lines, "    if dict_has_key(payload, \"id\") { request_id := payload[\"id\"] }")
    lines := push(lines, "    method := payload[\"method\"]")
    lines := push(lines, "    params := {}")
    lines := push(lines, "    if dict_has_key(payload, \"params\") && type(payload[\"params\"]) == \"dict\" { params := payload[\"params\"] }")
    lines := push(lines, "    if method == \"notifications/initialized\" { return json_response(202, {}) }")
    lines := push(lines, "    if method == \"ping\" { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {}}) }")
    lines := push(lines, "    if method == \"initialize\" { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {\"protocolVersion\": \"2025-11-25\", \"capabilities\": {\"tools\": {\"listChanged\": false}, \"resources\": {\"listChanged\": false}, \"prompts\": {\"listChanged\": false}}, \"serverInfo\": {\"name\": SERVER_NAME, \"version\": SERVER_VERSION}}}) }")
    lines := push(lines, "    if method == \"tools/list\" {")
    lines := push(lines, "        if !TOOLS_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32010, \"message\": \"Tools are disabled by configuration\"}}) }")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {\"tools\": standard_tool_list()}})")
    lines := push(lines, "    }")
    lines := push(lines, "    if method == \"tools/call\" {")
    lines := push(lines, "        if !TOOLS_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32010, \"message\": \"Tools are disabled by configuration\"}}) }")
    lines := push(lines, "        if !dict_has_key(params, \"name\") || trim(to_string(params[\"name\"])) == \"\" { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32602, \"message\": \"params.name is required\"}}) }")
    lines := push(lines, "        tool_name := trim(to_string(params[\"name\"]))")
    lines := push(lines, "        if find_tool(tool_name) == null { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32601, \"message\": \"Tool not found: \" + tool_name}}) }")
    lines := push(lines, "        tool_args := {}")
    lines := push(lines, "        if dict_has_key(params, \"arguments\") && type(params[\"arguments\"]) == \"dict\" { tool_args := params[\"arguments\"] }")
    lines := push(lines, "        outcome := execute_tool(tool_name, tool_args)")
    lines := push(lines, "        if outcome[\"ok\"] { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {\"content\": [{\"type\": \"text\", \"text\": to_json(outcome[\"data\"])}], \"structuredContent\": outcome[\"data\"], \"isError\": false}}) }")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -1, \"message\": outcome[\"error\"]}})")
    lines := push(lines, "    }")
    lines := push(lines, "    if method == \"resources/list\" {")
    lines := push(lines, "        if !RESOURCES_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32011, \"message\": \"Resources are disabled by configuration\"}}) }")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {\"resources\": standard_resource_list()}})")
    lines := push(lines, "    }")
    lines := push(lines, "    if method == \"resources/read\" {")
    lines := push(lines, "        if !RESOURCES_ENABLED { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32011, \"message\": \"Resources are disabled by configuration\"}}) }")
    lines := push(lines, "        if !dict_has_key(params, \"uri\") { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32602, \"message\": \"params.uri is required\"}}) }")
    lines := push(lines, "        outcome := read_resource(trim(to_string(params[\"uri\"])))")
    lines := push(lines, "        if outcome[\"ok\"] { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {\"contents\": [{\"uri\": params[\"uri\"], \"mimeType\": outcome[\"data\"][\"mime_type\"], \"text\": outcome[\"data\"][\"text\"]}]}}) }")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32002, \"message\": outcome[\"error\"]}})")
    lines := push(lines, "    }")
    lines := push(lines, "    if method == \"prompts/list\" { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": {\"prompts\": standard_prompt_list()}}) }")
    lines := push(lines, "    if method == \"prompts/get\" {")
    lines := push(lines, "        if !dict_has_key(params, \"name\") { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32602, \"message\": \"params.name is required\"}}) }")
    lines := push(lines, "        outcome := read_prompt(trim(to_string(params[\"name\"])))")
    lines := push(lines, "        if outcome[\"ok\"] { return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"result\": outcome[\"data\"]}) }")
    lines := push(lines, "        return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32602, \"message\": outcome[\"error\"]}})")
    lines := push(lines, "    }")
    lines := push(lines, "    return json_response(200, {\"jsonrpc\": \"2.0\", \"id\": request_id, \"error\": {\"code\": -32601, \"message\": \"Method not found: \" + method}})")
    lines := push(lines, "})")
    lines := push(lines, "")
    lines := push(lines, "print(\"Generated MCP server listening on http://\" + HOST + \":\" + to_string(PORT) + \"/mcp/v1\")")
    lines := push(lines, "server.listen()")

    return render_lines(lines)
}

func render_generated_readme(profile, out_abs) {
    return render_lines([
        "# Generated MCP Server",
        "",
        "This server was generated by `kujo mcp make` for repository **" + to_string(profile["repo_name"]) + "**.",
        "",
        "## Quick Start",
        "",
        "```bash",
        "kujo run " + out_abs + "/src/server.kujo --interpreter --self-check",
        "kujo run " + out_abs + "/src/server.kujo --interpreter",
        "```",
        "",
        "Default endpoint: `http://127.0.0.1:8941/mcp/v1`.",
        "",
        "## Safety",
        "",
        "- Read-only inspection tools are enabled by default.",
        "- Safe-command tools are limited to allowlisted commands in `mcp.manifest.json`.",
        "- Arbitrary shell command execution is not exposed.",
        "- Write operations are limited to generated output directories only."
    ])
}

func render_prompt_content(title, profile) {
    return render_lines([
        "# " + title,
        "",
        "Repository: " + to_string(profile["repo_name"]),
        "",
        "Use deterministic evidence from `repo-profile.json` and artifacts before proposing changes.",
        "If assumptions are uncertain, label them explicitly."
    ])
}

func render_smoke_script(out_abs) {
    return render_lines([
        "#!/usr/bin/env bash",
        "set -euo pipefail",
        "",
        "KUJO_BIN=\"" + "$" + "{KUJO_BIN:-kujo}\"",
        "SERVER_PID=\"\"",
        "LOG_FILE=\"$(mktemp)\"",
        "cleanup() {",
        "  if [[ -n \"$SERVER_PID\" ]]; then kill \"$SERVER_PID\" >/dev/null 2>&1 || true; wait \"$SERVER_PID\" >/dev/null 2>&1 || true; fi",
        "  rm -f \"$LOG_FILE\"",
        "}",
        "trap cleanup EXIT",
        "",
        "\"$KUJO_BIN\" run \"" + out_abs + "/src/server.kujo\" --interpreter --self-check >/dev/null",
        "\"$KUJO_BIN\" run \"" + out_abs + "/src/server.kujo\" --interpreter >\"$LOG_FILE\" 2>&1 &",
        "SERVER_PID=$!",
        "HEALTH=\"$(curl --retry 25 --retry-connrefused --retry-delay 1 -sS http://127.0.0.1:8941/mcp/v1/health)\"",
        "grep -q '\"status\":\"ok\"' <<<\"$HEALTH\"",
        "INIT=\"$(curl -sS -X POST http://127.0.0.1:8941/mcp/v1 -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\"}}')\"",
        "grep -q '\"protocolVersion\":\"2025-11-25\"' <<<\"$INIT\"",
        "PROMPTS=\"$(curl -sS -X POST http://127.0.0.1:8941/mcp/v1 -H 'Content-Type: application/json' -d '{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"prompts/list\",\"params\":{}}')\"",
        "grep -q 'prepare_implementation_plan' <<<\"$PROMPTS\"",
        "echo \"generated server smoke: ok\""
    ])
}

func ensure_generated_dirs(paths) {
    idx := 0
    while idx < len(paths) {
        ensure_result := ensure_dir_recursive(paths[idx])
        idx := idx + 1
        if !ensure_result["ok"] {
            return ensure_result
        }
    }
    return {"ok": true, "error": ""}
}

func write_generated_file(file_abs, content, write_roots, generated_files) {
    write_result := write_output_file(file_abs, content, write_roots)
    if !write_result["ok"] {
        return {"ok": false, "error": write_result["error"], "generated_files": generated_files}
    }
    return {"ok": true, "error": "", "generated_files": push(generated_files, file_abs)}
}

export func generate_server_project(profile, out_abs, artifacts_abs, dry_run, ai_tools) {
    write_roots := [out_abs, artifacts_abs]

    safe_command_map := {}
    tools := build_base_tools(profile)

    safe_tools := build_safe_command_tools(profile, safe_command_map)
    safe_idx := 0
    while safe_idx < len(safe_tools) {
        tools := push(tools, safe_tools[safe_idx])
        safe_idx := safe_idx + 1
    }

    deduped_tools := []
    seen_tool_names := {}
    dedupe_idx := 0
    while dedupe_idx < len(tools) {
        tool_entry := tools[dedupe_idx]
        dedupe_idx := dedupe_idx + 1
        if type(tool_entry) == "dict" && dict_has_key(tool_entry, "name") {
            tool_name := to_string(tool_entry["name"])
            if dict_has_key(seen_tool_names, tool_name) == false {
                seen_tool_names[tool_name] := true
                deduped_tools := push(deduped_tools, tool_entry)
            }
        }
    }
    tools := deduped_tools

    if type(ai_tools) == "array" {
        ai_idx := 0
        while ai_idx < len(ai_tools) {
            ai_tool := ai_tools[ai_idx]
            ai_idx := ai_idx + 1
            if type(ai_tool) == "dict" && dict_has_key(ai_tool, "name") {
                ai_name := to_string(ai_tool["name"])
                if dict_has_key(seen_tool_names, ai_name) == false {
                    seen_tool_names[ai_name] := true
                    tools := push(tools, ai_tool)
                }
            }
        }
    }

    resources := build_resources(profile, out_abs, artifacts_abs)
    prompts := build_prompts(out_abs)

    blocked_commands := []
    if dict_has_key(profile, "risky_operations") {
        risky := profile["risky_operations"]
        if type(risky) == "array" {
            ridx := 0
            while ridx < len(risky) {
                rentry := risky[ridx]
                ridx := ridx + 1
                if type(rentry) == "dict" {
                    if dict_has_key(rentry, "name") {
                        blocked_commands := push_unique(blocked_commands, to_string(rentry["name"]))
                    }
                }
            }
        }
    }

    manifest := {
        "server": {
            "name": to_string(profile["repo_name"]) + "-generated-mcp",
            "version": "1.0.0",
            "generated_at": format_date(now(), "YYYY-MM-DD HH:mm:ss"),
            "source_repo": to_string(profile["repo_path_absolute"])
        },
        "tools": tools,
        "resources": resources,
        "prompts": prompts,
        "safe_command_map": safe_command_map,
        "blocked_commands": blocked_commands,
        "safety_tiers": ["read_only", "safe_command", "write_scaffold", "review_required", "blocked"]
    }

    if dry_run {
        return {
            "ok": true,
            "error": "",
            "manifest": manifest,
            "generated_files": [],
            "note": "Dry run enabled; no files were written"
        }
    }

    ensure_dirs := ensure_generated_dirs([
        out_abs,
        artifacts_abs,
        out_abs + "/src",
        out_abs + "/src/tools",
        out_abs + "/src/resources",
        out_abs + "/src/prompts",
        out_abs + "/src/safety",
        out_abs + "/tests",
        out_abs + "/examples"
    ])
    if !ensure_dirs["ok"] {
        return {"ok": false, "error": ensure_dirs["error"], "manifest": {}}
    }

    generated_files := []

    profile_json := to_json(profile)
    manifest_json := to_json(manifest)

    write_profile := write_generated_file(out_abs + "/repo-profile.json", profile_json, write_roots, generated_files)
    if !write_profile["ok"] {
        return {"ok": false, "error": write_profile["error"], "manifest": manifest}
    }
    generated_files := write_profile["generated_files"]

    write_manifest := write_generated_file(out_abs + "/mcp.manifest.json", manifest_json, write_roots, generated_files)
    if !write_manifest["ok"] {
        return {"ok": false, "error": write_manifest["error"], "manifest": manifest}
    }
    generated_files := write_manifest["generated_files"]

    mcp_server_json := to_json({
        "server": {
            "name": to_string(manifest["server"]["name"]),
            "version": "1.0.0",
            "description": "Generated MCP server"
        },
        "http": {
            "host": "127.0.0.1",
            "port": 8941,
            "max_request_body_bytes": 262144,
            "rate_limit_enabled": true,
            "rate_limit_per_minute": 300,
            "rate_limit_strategy": "local"
        },
        "auth": {
            "enabled": false,
            "type": "bearer",
            "token": ""
        },
        "permissions": {
            "allowed_directories": [to_string(profile["repo_path_absolute"]), out_abs, artifacts_abs],
            "max_file_size": 1048576,
            "read_only_patterns": ["*.md", "*.json", "*.yaml", "*.yml", "*.toml", "*.lock", "*.env", "*.pem", "*.key"]
        },
        "tools": {
            "enabled": true,
            "default_timeout_ms": 120000
        },
        "resources": {
            "enabled": true
        }
    })

    write_cfg := write_generated_file(out_abs + "/mcp-server.json", mcp_server_json, write_roots, generated_files)
    if !write_cfg["ok"] {
        return {"ok": false, "error": write_cfg["error"], "manifest": manifest}
    }
    generated_files := write_cfg["generated_files"]

    server_source := render_generated_server_source(out_abs + "/mcp.manifest.json", out_abs + "/repo-profile.json", out_abs + "/mcp-server.json", out_abs, artifacts_abs)
    write_server := write_generated_file(out_abs + "/src/server.kujo", server_source, write_roots, generated_files)
    if !write_server["ok"] {
        return {"ok": false, "error": write_server["error"], "manifest": manifest}
    }
    generated_files := write_server["generated_files"]

    readme_text := render_generated_readme(profile, out_abs)
    write_readme := write_generated_file(out_abs + "/README.md", readme_text, write_roots, generated_files)
    if !write_readme["ok"] {
        return {"ok": false, "error": write_readme["error"], "manifest": manifest}
    }
    generated_files := write_readme["generated_files"]

    safety_text := "# Safety Policy\n\nThis generated server is read-only by default and allows only allowlisted safe commands defined in mcp.manifest.json.\n"
    write_safety := write_generated_file(out_abs + "/src/safety/policy.md", safety_text, write_roots, generated_files)
    if !write_safety["ok"] {
        return {"ok": false, "error": write_safety["error"], "manifest": manifest}
    }
    generated_files := write_safety["generated_files"]

    tools_notes := "# Generated Tools\n\nSee mcp.manifest.json for generated tool definitions.\n"
    write_tools_notes := write_generated_file(out_abs + "/src/tools/README.md", tools_notes, write_roots, generated_files)
    if !write_tools_notes["ok"] {
        return {"ok": false, "error": write_tools_notes["error"], "manifest": manifest}
    }
    generated_files := write_tools_notes["generated_files"]

    resource_notes := "# Generated Resources\n\nSee mcp.manifest.json for generated resource definitions.\n"
    write_res_notes := write_generated_file(out_abs + "/src/resources/README.md", resource_notes, write_roots, generated_files)
    if !write_res_notes["ok"] {
        return {"ok": false, "error": write_res_notes["error"], "manifest": manifest}
    }
    generated_files := write_res_notes["generated_files"]

    prompt_idx := 0
    while prompt_idx < len(prompts) {
        prompt := prompts[prompt_idx]
        prompt_idx := prompt_idx + 1
        prompt_name := to_string(prompt["name"])
        prompt_path := to_string(prompt["path"])
        prompt_content := render_prompt_content(prompt_name, profile)
        write_prompt := write_generated_file(prompt_path, prompt_content, write_roots, generated_files)
        if !write_prompt["ok"] {
            return {"ok": false, "error": write_prompt["error"], "manifest": manifest}
        }
        generated_files := write_prompt["generated_files"]
    }

    smoke_text := render_smoke_script(out_abs)
    write_smoke := write_generated_file(out_abs + "/tests/smoke.sh", smoke_text, write_roots, generated_files)
    if !write_smoke["ok"] {
        return {"ok": false, "error": write_smoke["error"], "manifest": manifest}
    }
    generated_files := write_smoke["generated_files"]

    examples_client := "# Client Usage\n\n1. Start server: `kujo run src/server.kujo --interpreter`\n2. Call `/mcp/v1/tools/list` and `/mcp/v1/tools/call`.\n"
    write_client := write_generated_file(out_abs + "/examples/client-usage.md", examples_client, write_roots, generated_files)
    if !write_client["ok"] {
        return {"ok": false, "error": write_client["error"], "manifest": manifest}
    }
    generated_files := write_client["generated_files"]

    examples_calls := "# Sample Calls\n\n- `inspect_project_structure`\n- `list_available_scripts`\n- `find_relevant_files_for_task`\n"
    write_calls := write_generated_file(out_abs + "/examples/sample-calls.md", examples_calls, write_roots, generated_files)
    if !write_calls["ok"] {
        return {"ok": false, "error": write_calls["error"], "manifest": manifest}
    }
    generated_files := write_calls["generated_files"]

    return {
        "ok": true,
        "error": "",
        "manifest": manifest,
        "generated_files": generated_files,
        "note": "Generated server project written successfully"
    }
}
