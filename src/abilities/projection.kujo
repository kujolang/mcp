from ability import ABILITY_SCHEMA_ID, ABILITY_EXPOSURE_SCHEMA_ID, validate_ability_definition, validate_ability_exposure, ability_definition_digest, list_ability_definitions

export ABILITY_SCHEMA_ID := ABILITY_SCHEMA_ID
export ABILITY_EXPOSURE_SCHEMA_ID := ABILITY_EXPOSURE_SCHEMA_ID
export validate_ability_definition := validate_ability_definition

func dict_get_or(obj, key, fallback) {
    if type(obj) != "dict" { return fallback }
    if has_key(obj, key) { return obj[key] }
    return fallback
}

func failure(code, message, details) {
    return {"ok": false, "code": code, "message": message, "details": details}
}

func array_contains(values, expected) {
    for value in values { if value == expected { return true } }
    return false
}

func normalized_exposure(definition, exposure_input) {
    exposure := exposure_input
    if type(exposure) != "dict" { return failure("invalid_ability_exposure", "MCP exposure must be an object", {}) }
    if dict_get_or(exposure, "schema", "") == ABILITY_EXPOSURE_SCHEMA_ID {
        validation := validate_ability_exposure(exposure)
        if validation["ok"] == false { return validation }
        if exposure["ability_id"] != definition["id"] || exposure["ability_version"] != definition["version"] { return failure("ability_exposure_identity_mismatch", "MCP exposure must identify the projected Ability", {}) }
        if exposure["surface"] != "mcp" { return failure("ability_exposure_surface_mismatch", "Ability exposure surface must be mcp", {"surface": exposure["surface"]}) }
        metadata := dict_get_or(exposure, "metadata", {})
        return {
            "ok": true,
            "enabled": exposure["enabled"],
            "name": exposure["name"],
            "public": exposure["public"],
            "allowed_effects": dict_get_or(metadata, "allowed_effects", ["read"]),
            "metadata": metadata
        }
    }
    return {
        "ok": true,
        "enabled": dict_get_or(exposure, "enabled", false),
        "name": dict_get_or(exposure, "name", ""),
        "public": dict_get_or(exposure, "public", false),
        "allowed_effects": dict_get_or(exposure, "allowed_effects", ["read"]),
        "metadata": dict_get_or(exposure, "metadata", {})
    }
}

export ability_to_mcp_tool := func(definition_input, exposure_input) {
    validated := validate_ability_definition(definition_input)
    if validated["ok"] == false { return validated }
    definition := validated["definition"]
    exposure_result := normalized_exposure(definition, exposure_input)
    if exposure_result["ok"] == false { return exposure_result }
    if exposure_result["enabled"] != true { return failure("ability_not_exposed", "Ability requires an explicit enabled MCP exposure", {}) }
    allowed_effects := exposure_result["allowed_effects"]
    if type(allowed_effects) != "array" || len(allowed_effects) < 1 { return failure("invalid_ability_exposure", "allowed_effects must be a non-empty array", {}) }
    for effect in definition["effects"] {
        if array_contains(allowed_effects, effect["kind"]) == false {
            return failure("ability_effect_not_exposed", "Ability effect is outside the MCP exposure policy", {"kind": effect["kind"], "resource": effect["resource"]})
        }
    }
    name := trim(to_string(exposure_result["name"]))
    if name == "" || len(name) > 128 || regex_replace(name, "[^a-zA-Z0-9_-]", "") != name { return failure("invalid_ability_tool_name", "MCP exposure name is invalid", {}) }
    read_only_hint := false
    if len(definition["effects"]) == 1 && definition["effects"][0]["kind"] == "read" { read_only_hint = true }
    destructive_hint := false
    for effect in definition["effects"] { if effect["kind"] == "delete" { destructive_hint = true } }
    digest := ability_definition_digest(definition)
    if digest["ok"] == false { return digest }
    return {
        "ok": true,
        "tool": {
            "name": name,
            "description": definition["description"],
            "inputSchema": definition["input_schema"],
            "outputSchema": definition["output_schema"],
            "annotations": {
                "readOnlyHint": read_only_hint,
                "destructiveHint": destructive_hint
            },
            "_meta": {
                "kujo/abilityId": definition["id"],
                "kujo/abilityVersion": definition["version"],
                "kujo/abilityDefinitionDigest": digest["digest"],
                "kujo/abilityEffects": definition["effects"],
                "kujo/abilityIdempotency": definition["idempotency"],
                "kujo/public": exposure_result["public"]
            }
        }
    }
}

export ability_registry_to_mcp_tools := func(registry) {
    tools := []
    names := {}
    for entry in list_ability_definitions(registry, "mcp") {
        projection := ability_to_mcp_tool(entry["definition"], entry["exposure"])
        if projection["ok"] == false { return projection }
        name := projection["tool"]["name"]
        if has_key(names, name) { return failure("ability_tool_name_collision", "Two MCP Ability exposures use the same tool name", {"name": name}) }
        names[name] := true
        tools = push(tools, projection["tool"])
    }
    return {"ok": true, "tools": tools}
}
