{
  "name": "mcp-launch-readiness",
  "version": "0.1.0",
  "tests": [
    {
      "name": "MCP help command succeeds",
      "check": "command_succeeds",
      "params": {
        "command": "kujo run mcp.kujo help"
      }
    },
    {
      "name": "MCP package metadata exists",
      "check": "file_exists",
      "params": {
        "path": "kennel.toml"
      }
    },
    {
      "name": "MCP project metadata exists",
      "check": "file_exists",
      "params": {
        "path": "kujo.toml"
      }
    }
  ]
}
