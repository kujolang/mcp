from mcp import check_path

allowed_dir := "./demo"
read_only_patterns := ["*.md", "*.txt", "*.json", "*.yaml", "*.yml"]

# Positive path cases should always remain allowed.
allowed_read := check_path("./demo/docs/README.md", allowed_dir, read_only_patterns, false)
assert(allowed_read["ok"] == true, "valid in-scope read path should be allowed")

allowed_write := check_path("./demo/patches/sec_01_patch.kujo", allowed_dir, read_only_patterns, true)
assert(allowed_write["ok"] == true, "valid in-scope write path should be allowed")

# Traversal vectors must be denied for both read and write operations.
traversal_read := check_path("./demo/docs/../../README.md", allowed_dir, read_only_patterns, false)
assert(traversal_read["ok"] == false, "traversal read path should be denied")

traversal_write := check_path("./demo/../sec_01_outside.kujo", allowed_dir, read_only_patterns, true)
assert(traversal_write["ok"] == false, "traversal write path should be denied")

# Sibling-prefix bypass vectors (demo2 vs demo) must be denied.
demo2_created := false
if !path_exists("./demo2") {
    create_dir("./demo2")
    demo2_created := true
}

sibling_path := "./demo2/sec_01_sibling.kujo"
write_file(sibling_path, "temporary")

sibling_write := check_path(sibling_path, allowed_dir, read_only_patterns, true)
assert(sibling_write["ok"] == false, "sibling-prefix write path should be denied")

delete_file(sibling_path)
if demo2_created {
    os_rmdir("./demo2")
}

print("sec_01_path_guard: all assertions passed")