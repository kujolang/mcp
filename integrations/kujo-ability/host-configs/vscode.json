{
  "servers": {
    "kujo-ability": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/bin/kujo-ability-mcp.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": { "KUJO_ABILITY_GATEWAY_URL": "https://cms.example.com", "KUJO_ABILITY_GATEWAY_TOKEN": "${input:kujoAbilityToken}" }
    }
  },
  "inputs": [{ "id": "kujoAbilityToken", "type": "promptString", "description": "Least-privilege Kujo Ability bearer token", "password": true }]
}
